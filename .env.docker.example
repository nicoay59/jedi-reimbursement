# Port aplikasi full Docker
FRONTEND_PORT=8088
MYSQL_PORT=3306
TZ=Asia/Jakarta

# Nama volume persisten
MYSQL_VOLUME_NAME=jedi_reimbursement_mysql_data
UPLOAD_VOLUME_NAME=jedi_reimbursement_uploads

# Database
MYSQL_ROOT_PASSWORD=root
DB_NAME=jedi_reimbursement
DB_USER=jedi_user
DB_PASSWORD=jedi_password
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# Ganti dengan string acak minimal 32 karakter
JWT_SECRET=replace-this-with-a-long-random-secret-before-production
JWT_EXPIRES_IN_MINUTES=480

# Upload
PARKING_RECEIPT_MAX_MB=5

# Akun seed administrator
ADMIN_EMPLOYEE_NUMBER=ADM001
ADMIN_FULL_NAME=Administrator
ADMIN_EMAIL=admin@jedi.local
ADMIN_PASSWORD=Admin123!
ADMIN_POSITION=System Administrator
ADMIN_DIVISION=Information Technology

# Akun seed karyawan
EMPLOYEE_EMPLOYEE_NUMBER=EMP001
EMPLOYEE_FULL_NAME=Karyawan Contoh
EMPLOYEE_EMAIL=employee@jedi.local
EMPLOYEE_PASSWORD=Employee123!
EMPLOYEE_POSITION=Staff
EMPLOYEE_DIVISION=Operations
